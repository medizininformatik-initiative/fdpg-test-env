TZ=Europe/Berlin
DEV_DSF_BPE_FHIR_SERVER_BASE_URL=https://{{ domain }}/fhir
DEV_DSF_BPE_DB_URL=jdbc:postgresql://db/bpe
DEV_DSF_SERVER_AUTH_TRUST_CLIENT_CERTIFICATE_CAS=/run/secrets/ssl_ca_certificate_file.pem
DEV_DSF_BPE_DB_LIQUIBASE_PASSWORD_FILE=/run/secrets/db_liquibase.password
DEV_DSF_BPE_DB_USER_PASSWORD_FILE=/run/secrets/db_user.password
DEV_DSF_BPE_DB_USER_CAMUNDA_PASSWORD_FILE=/run/secrets/db_user_camunda.password
DEV_DSF_BPE_FHIR_CLIENT_TRUST_SERVER_CERTIFICATE_CAS=/run/secrets/app_client_trust_certificates.pem
DEV_DSF_BPE_FHIR_CLIENT_CERTIFICATE=/run/secrets/app_client_certificate.pem
DEV_DSF_BPE_FHIR_CLIENT_CERTIFICATE_PRIVATE_KEY=/run/secrets/app_client_certificate_private_key.pem
DEV_DSF_BPE_PROCESS_EXCLUDED="{{ dsf_process_excluded | select() | join(',') }}"

DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_EVALUATION_STRATEGY={{ evaluation_strategy }}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_EVALUATION_OBFUSCATE={{ evaluation_obfuscate }}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_TRUST_STORE_PATH=/run/secrets/trust_store.jks
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_TRUST_STORE_PASSWORD=password
{% if evaluation_strategy in ["ccdl", "structured-query"] -%}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_FLARE_BASE_URL=https://{{ fhir_domain}}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_AUTH_BASIC_USERNAME={{ env }}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_AUTH_BASIC_PASSWORD={{ basic_auth_password }}
{% else -%}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_BASE_URL=https://{{ fhir_domain}}/fhir
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_AUTH_OAUTH_CLIENT_ID={{ client_id }}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_AUTH_OAUTH_CLIENT_PASSWORD={{ client_secret }}
DE_MEDIZININFORMATIK_INITIATIVE_FEASIBILITY_DSF_PROCESS_CLIENT_STORE_AUTH_OAUTH_ISSUER_URL="{{ issuer_url }}"
{% endif -%}

DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_BASE_URL=https://{{ fhir_domain}}/fhir
DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_OAUTH2_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_OAUTH2_URL="{{ issuer_url }}"
DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_OAUTH2_CLIENT_ID={{ client_id }}
DE_MEDIZININFORMATIK_INITIATIVE_REPORT_DIC_FHIR_SERVER_OAUTH2_CLIENT_PASSWORD={{ client_secret }}

DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_BASE_URL=https://{{ fhir_domain}}/fhir
DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_OAUTH2_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_OAUTH2_URL="{{ issuer_url }}"
DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_OAUTH2_CLIENT_ID={{ client_id }}
DE_MEDIZININFORMATIK_INITIATIVE_DATA_SHARING_DIC_FHIR_SERVER_OAUTH2_CLIENT_PASSWORD={{ client_secret }}

DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_BASE_URL=https://{{ fhir_domain}}/fhir
DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_OAUTH2_TRUST_CERTIFICATES=/run/secrets/ssl_ca_certificate_file.pem
DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_OAUTH2_URL="{{ issuer_url }}"
DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_OAUTH2_CLIENT_ID={{ client_id }}
DE_MEDIZININFORMATIK_INITIATIVE_DATA_TRANSFER_DIC_FHIR_SERVER_OAUTH2_CLIENT_PASSWORD={{ client_secret }}
